{
  "name": "amanah/backend",
  "description": "Backend PHP d'Amanah, compatible avec un hébergement mutualisé.",
  "type": "project",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Amanah\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t ../public ../tools/router.php",
    "test": "php -d zend.assertions=1 -d assert.exception=1 tests/SmokeTest.php"
  }
}
